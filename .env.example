# Copy to .env.local (gitignored). NINES is fully playable with none of these set: guests play, progress stays in
# the browser, and the AI coach falls back to self-grading. Step-by-step setup for the parts below: SUPABASE_SETUP.md.
# Never commit real values. Anything starting NEXT_PUBLIC_ is sent to the browser; everything else stays on the server.

# ---------------------------------------------------------------- Site
# Your public URL, no trailing slash. Used for link previews and sign-in redirects. Vercel sets one automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------------------------------------------------------------- Supabase (accounts, saved progress)
# Supabase dashboard > Project Settings > API (Data API / API keys).
NEXT_PUBLIC_SUPABASE_URL=
# The public key ("anon" key, or "publishable" key starting sb_publishable_). Safe for the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The SECRET key ("service_role" key, or "secret" key starting sb_secret_). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Only for running the migration from your machine (scripts/db-migrate.mts). Not used by the app; do NOT add it to Vercel.
# Supabase > Connect > Connection string > URI (use the Session pooler string if your network has no IPv6).
# SUPABASE_DB_URL=

# ---------------------------------------------------------------- Admin and privacy
# Comma-separated sign-in emails allowed to open /admin. They must be confirmed addresses (Google, or an emailed link).
ADMIN_EMAILS=
# Shown on the /privacy page as the contact for data requests. Set this before you share the site.
PRIVACY_CONTACT_EMAIL=

# ---------------------------------------------------------------- Analytics (optional, PostHog)
# Anonymous counts for the funnel. Without the key, nothing is collected.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Only to show Visited/Started on /admin: the project id and a personal API key with "query read" access.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# ---------------------------------------------------------------- Shared AI coach (optional, Groq)
# The site's own key, used for players who haven't added their own. Players can also add their own Groq or Claude
# key in Settings; that key stays in their browser and never reaches this server.
GROQ_API_KEY=
# Hard caps on the shared key's spend, in USD, across all players.
NINES_MONTHLY_BUDGET_USD=5
# NINES_DAILY_BUDGET_USD=0.5
# Guests' AI quotas are keyed by a salted hash of their address, never the address itself. Set any random string.
IP_HASH_SALT=

# ---------------------------------------------------------------- Local development only
# With no Supabase variables set, sign-in is a dev-only email box and data goes to .nines/store.json.
# NINES_DEV_LOGIN=1   # allow that dev login in a production build (the e2e suite does this; never on a public site)
