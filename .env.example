# Copy to .env (gitignored). NINES is fully playable with none of these set. See DEPLOY.md for production.

# AI coach (Groq). Read server-side only.
GROQ_API_KEY=
# Hard caps on AI spend, in USD, across all players.
NINES_MONTHLY_BUDGET_USD=5
# NINES_DAILY_BUDGET_USD=0.5

# Accounts (optional locally: a dev email login is available outside production).
# AUTH_SECRET=            # required in production: `npx auth secret`
# OWNER_EMAILS=you@example.com   # owner edition (personal notes) and /admin
# AUTH_GOOGLE_ID= / AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID= / AUTH_GITHUB_SECRET=

# Storage. Without DATABASE_URL, users/progress/usage/feedback go to .nines/store.json (dev only).
# DATABASE_URL=postgres://...    # Neon
# IP_HASH_SALT=random-string     # guests' AI quotas are keyed by a salted hash, never a raw address
