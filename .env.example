# Copy to .env (gitignored). NINES is fully playable without a key.
# With a key: AI-graded explanations and postmortems, and the live "Ask the SRE" hints.
# Provider: Groq (gpt-oss models, see src/config/models.ts). The key is read server-side only.
GROQ_API_KEY=

# Hard monthly cap on AI spend, in USD (enforced server-side before every call).
NINES_MONTHLY_BUDGET_USD=5
