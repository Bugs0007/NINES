import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
for (const s of ["range", "hash", "compound", "directory"]) for (const w of ["timeseries", "users"]) run("shard-lab", { strategy: s, workload: w }, ["maxShare", "deviceRangeFanout", "allRangeFanout", "metaCost"]);
for (const k of ["user", "conv", "message", "created", "country"]) for (const c of [false, true]) run("shardkey-lab", { key: k, copy: c }, ["balance", "singleShardReads", "writeAmp", "hotRisk"]);
for (const [p, s, c] of [[0.15, 1, false], [0.15, 4, false], [0.15, 8, false], [0.15, 16, false], [0.15, 1, true], [0.15, 2, true], [0.4, 4, true], [0.4, 8, true], [0.001, 1, false]] as const) run("hotpart-lab", { p, salt: s, cache: c }, ["hotUtil", "avgUtil"]);
for (const [m, n, vn] of [["mod", 10, 1], ["ring", 10, 1], ["ring", 10, 10], ["ring", 10, 50], ["ring", 10, 100], ["ring", 10, 200], ["ring", 10, 400], ["ring", 20, 100]] as const) run("ring-lab", { method: m, nodes: n, vnodes: vn }, ["imbalance", "movedOnAdd", "stdev"]);
for (const [r, s] of [[20, 4], [5, 2], [60, 5], [50, 6], [100, 10], [400, 20], [30, 8], [40, 6]] as const) run("rebalance-lab", { rate: r, streams: s }, ["hours", "p99Increase", "totalMBs"]);
