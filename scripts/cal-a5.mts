import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${o.metrics[k]!.toFixed(3)}`).join(" ")); };
const bt = { lockRows: true, rows: 500000000 };
for (const v of [{}, { conv: true }, { conv: true, user: true, created: true }, { conv: true, user: true, created: true, body: true }, { conv: true, user: true }]) run("btree-lab", v, ["worstMs", "writeMs", "indexGB"], bt);
for (const i of ["none", "conv", "sent", "both"]) for (const c of [false, true]) run("plan-lab", { index: i, covering: c }, ["ms", "rowsExamined"]);
for (const v of [{}, { name: true, avatar: true, verified: true }, { name: true, avatar: true, verified: true, followers: true }, { name: true, avatar: true, verified: true, followers: true }]) run("join-lab", v, ["readMs", "writeRowsPerSec", "joins"]);
for (const [r, p] of [["primary", 0.2], ["primary", 0.01], ["replica", 0.2], ["replica", 0.01], ["none", 0.5]] as const) run("mvcc-lab", { report: r, scale: p }, ["maxBloat", "vacuums"]);
for (const e of ["btree", "leveled", "tiered"]) for (const b of [false, true]) run("lsm-lab", { engine: e, bloom: b }, ["diskWriteMBs", "readIos", "spaceFactor"], { lockWrites: true, writes: 100000 });
for (const v of [{}, { redis: true }, { search: true }, { big: true }, { redis: true, search: true }, { queue: true, vector: true }]) run("pg-lab", v, ["pgUtil", "extraSystems", "costPerMonth"]);
for (const v of [{}, { index: true, strategy: "lock", hold: "short", report: "replica" }, { index: true, strategy: "unique", hold: "short", report: "replica" }, { index: true, strategy: "ser", hold: "short", report: "replica" }, { index: true, strategy: "lock", hold: "payment", report: "replica" }]) run("seat-lab", v, ["oversold", "p99", "abortRate", "bloat"]);
