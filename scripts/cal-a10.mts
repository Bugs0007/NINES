import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
const ac = { lockClient: true, client: "mobile" };
for (const [s, l] of [["rest", false], ["graphql", false], ["graphql", true], ["grpc", false]] as const) run("apistyle-lab", { style: s, loader: l }, ["loadMs", "kb", "dbQueries", "needsProxy", "rounds"], ac);
for (const c of ["browser", "service"]) for (const s of ["rest", "grpc"]) run("apistyle-lab", { style: s, client: c }, ["loadMs", "needsProxy"]);
const pc = { lockPage: true, page: 100000, inserts: 20 };
for (const [m, i] of [["offset", true], ["cursor", true], ["cursor", false]] as const) run("pagination-lab", { method: m, indexed: i }, ["queryMs", "dupPerPage", "rowsScanned", "canJump"], pc);
for (const p of [1, 100, 10000]) run("pagination-lab", { method: "offset", page: p }, ["queryMs"]);
run("idemkey-lab", {}, ["doublePerMillion", "wrongPerMillion", "stuckPerMillion", "leakPerMillion"]);
run("idemkey-lab", { inflight: "wait", mismatch: "reject", failure: "release", scope: "account" }, ["doublePerMillion", "wrongPerMillion", "stuckPerMillion", "leakPerMillion"]);
for (const [s, w] of [["breaking", 24], ["urls", 12], ["urls", 24], ["urls", 36], ["urls", 60], ["additive", 24], ["datepin", 24]] as const) run("apiversion-lab", { strategy: s, window: w }, ["brokenPct", "costFTE", "blockedPerYear"]);
for (const [a, b] of [["fixed", 5], ["slog", 5], ["scounter", 5], ["bucket", 2], ["bucket", 10], ["leaky", 10], ["leaky", 2]] as const) run("ratelimiter-lab", { algo: a, burst: b }, ["worstPerSec", "legitRejectedPct", "legitDelayMs", "memoryBytes"]);
const tc = { lockClients: true, clients: 200000 };
for (const [t, p] of [["polling", 1], ["polling", 10], ["longpoll", 5], ["sse", 5], ["ws", 5]] as const) run("transport-lab", { transport: t, pollS: p }, ["reqPerSec", "avgDelayMs", "connections", "memGB", "wastedPct"], tc);
for (const [a, b, s, t] of [[3, 5, false, 0], [12, 5, true, 5], [10, 5, true, 5], [11, 5, true, 5], [8, 60, true, 5], [12, 5, true, 0], [12, 5, false, 5], [14, 60, true, 5], [14, 5, true, 5]] as const) run("webhook-lab", { attempts: a, baseS: b, signature: s, tolerance: t }, ["lostFrac", "horizonH", "spoofAccepted", "replayAccepted"]);
