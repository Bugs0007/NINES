import { fanoutEval, poolEval, autoRun, autoscaleLab, viralLab, poolLab } from "../src/widgets/model-lab/models/a2";
const f = { median: 0.02, p99: 0.12, calls: 40, minCalls: 10, maxCalls: 200 };
for (const n of [10, 20, 40]) for (const h of [0, 40, 60, 80, 100, 150]) { const e = fanoutEval(f, n, h / 1000); console.log("fan", n, h, e.p99.toFixed(3), e.slowShare.toFixed(3), e.extraLoad.toFixed(3)); }
const pc = { appWorkers: 16, poolPerWorker: 10, dbCores: 4, maxConnections: 100, reserved: 3, queryMs: 8, rps: 600, poolerSize: 20 };
for (const [w, p, on, ps] of [[16, 10, false, 20], [16, 5, false, 20], [16, 3, false, 20], [16, 2, false, 20], [16, 1, false, 20], [16, 10, true, 10], [16, 10, true, 20], [16, 10, true, 40], [16, 10, true, 4]] as const) { const e = poolEval(pc, w, p, on, ps); console.log("pool", w, p, on, ps, e.serverConns, e.p99.toFixed(3), e.errorRate.toFixed(3), e.util.toFixed(2)); }
const ac = { baseRps: 200, peakRps: 1800, riseS: 60, holdS: 360, durationS: 720, perInstanceRps: 100, bootS: 150, warmBootS: 30, periodS: 60, startInstances: 3, maxInstances: 40, serviceMs: 50, queueS: 2, usdPerInstanceHour: 0.1008 };
for (const [t, m, w] of [[0.6, 3, false], [0.4, 3, false], [0.4, 8, false], [0.6, 10, false], [0.6, 3, true], [0.4, 3, true], [0.3, 6, true], [0.5, 8, true], [0.6, 12, true], [0.6, 18, false], [0.5, 12, false], [0.3, 12, false]] as const) { const r = autoRun(ac, t, m, w); console.log("auto", t, m, w, "peak", r.peakLatency.toFixed(2), "p99", r.p99.toFixed(2), "drop", r.dropShare.toFixed(3), "cost", r.costUsd.toFixed(2), "inst", r.maxInstances, "over", r.overS); }
