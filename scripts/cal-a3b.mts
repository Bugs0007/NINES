import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (v: Record<string, number | string | boolean>) => { const m = LAB_MODELS["far-lab"]!; const o = m.evaluate({ ...m.init({}), ...v }, {}); console.log(JSON.stringify(v), ["p75Ms","worstMs","costPerMonth","staleSec"].map((k) => `${k}=${o.metrics[k]!.toFixed(0)}`).join(" ")); };
for (const ttl of [3600, 7200]) for (const [t,h,k] of [[false,true,true],[true,false,true],[false,true,false],[true,true,true],[false,false,false]] as const) run({ cdn: true, ttl, tls13: t, h3: h, keepalive: k });
run({ cdn:false, tls13:true, region2:"sg", keepalive:true });
const r2 = (id: string, cfg: Record<string, unknown>, v: Record<string, number | string | boolean>, keys: string[]) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${o.metrics[k]!.toFixed(3)}`).join(" ")); };
for (const [pops, ttl] of [[1,60],[2,3600],[3,60],[3,900],[3,3600],[4,3600],[5,3600],[3,300]] as const) r2("cdn-lab", {}, { cdn: true, pops, ttl, rate: 0.01 }, ["avgMs", "worstMs", "hitRatio"]);
for (const s of [2,3,4,5]) r2("anycast-lab", {}, { method: "anycast", sites: s, down: true }, ["avgMs", "failoverS"]);
for (const s of [3,4,5]) r2("anycast-lab", {}, { method: "dns", sites: s, down: true, ttl: 30 }, ["avgMs", "failoverS"]);
for (const [d,t,r,e] of [[true,true,true,false],[false,true,true,false],[true,false,true,false],[false,false,false,true],[true,true,false,false]] as const) r2("journey-lab", {}, { region: "frankfurt", dnsCached: d, tls13: t, reuse: r, edge: e }, ["ttfbMs", "originTrips"]);
r2("proxy-lab", { rps: 150 }, { buffering: false, slowShare: 0.15, workers: 32 }, ["p99", "errorRate"]);
r2("proxy-lab", { rps: 150 }, { buffering: true, slowShare: 0.15, workers: 12 }, ["p99", "errorRate"]);
