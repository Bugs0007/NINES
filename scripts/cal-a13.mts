import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
for (const l of ["standard", "ia", "archive"]) run("blob-lab", { life: l }, ["costPerMonth", "slowReadsPct", "appServers", "wastedUploadPct"]);
for (const [s, p] of [["scan", false], ["merge", false], ["skip", false], ["skip", true]] as const) run("invindex-lab", { strategy: s, positions: p }, ["queryMs", "indexGB", "phraseOk"]);
for (const [m, p, n] of [["scan", "6", false], ["lat", "6", false], ["geohash", "4", true], ["geohash", "5", true], ["geohash", "6", true], ["geohash", "7", true], ["geohash", "8", true], ["geohash", "5", false], ["geohash", "6", false], ["geohash", "7", false]] as const) run("geo-lab", { method: m, precision: p, neighbours: n }, ["queryMs", "candidates", "missPct", "lookups"]);
for (const [r, a, h, c, u] of [[7, 0, 0, false, false], [7, 0, 0, true, false], [7, 14, 730, true, false], [7, 90, 730, true, false], [7, 0, 365, true, false], [30, 365, 0, false, false], [7, 14, 730, true, true], [3, 7, 400, true, false]] as const) run("tsdb-lab", { rawDays: r, r1m: a, r1h: h, compress: c, userTag: u }, ["storageGB", "yearQueryMs", "indexMemGB", "yearCoverage"]);
