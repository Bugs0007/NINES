import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
const cc = { lockPartition: true, partitionMin: 30 };
for (const p of ["cp", "ap"]) for (const e of ["consistency", "latency"]) for (const mg of [false, true]) run("cap-lab", { policy: p, elsePart: e, merge: mg }, ["unavailMin", "conflicts", "commitMs", "stalePct"], cc);
const kc = { lockLag: true, lagMs: 800 };
for (const l of ["linear", "sequential", "causal", "eventual"]) run("consistency-lab", { level: l }, ["ownMiss", "staleOthers", "monotonic", "readMs", "availPartition"], kc);
const lc = { lockSigma: true, sigma: 30 };
for (const s of ["physical", "lamport", "hlc", "truetime", "vector"]) run("clock-lab", { scheme: s }, ["wrongOrderPct", "silentLossPerDay", "commitWaitMs", "metaBytes"], lc);
for (const sg of [1, 5, 10, 30, 100, 200]) run("clock-lab", { scheme: "physical", sigma: sg }, ["wrongOrderPct"]);
for (const [t, h, n] of [[300, 100, "5"], [150, 50, "5"], [500, 100, "5"], [800, 100, "5"], [1000, 100, "5"], [1000, 200, "5"], [1500, 150, "5"], [2000, 200, "5"], [5000, 500, "5"], [1000, 100, "3"], [1000, 100, "7"], [100, 50, "5"], [60, 20, "7"], [200, 100, "5"], [600, 100, "5"]] as const) run("raft-lab", { timeout: t, heartbeat: h, nodes: n }, ["failoverMs", "falsePerHour", "splitPct"]);
for (const [t, f] of [[1, false], [5, false], [10, false], [30, false], [60, false], [120, false], [10, true], [60, true]] as const) run("lock-lab", { ttl: t, fencing: f }, ["corruptPerDay", "recoveryS", "staleRejected"]);
const sc = { failPct: 0.02 };
for (const [p, r, i] of [["twopc", 0, false], ["saga", 0, false], ["saga", 1, true], ["saga", 2, false], ["saga", 2, true], ["saga", 3, true]] as const) run("saga-lab", { proto: p, retries: r, idemComp: i }, ["lockHoldMs", "successRate", "dupRefundsPerMillion"], sc);
for (const [p, ms, d] of [["dbfirst", 1000, false], ["brokerfirst", 1000, false], ["poll", 1000, false], ["poll", 400, true], ["poll", 1000, true], ["cdc", 1000, true], ["poll", 200, true]] as const) run("outbox-lab", { pattern: p, pollMs: ms, dedup: d }, ["lostPerDay", "phantomPerDay", "appliedTwicePerDay", "extraLatencyMs"]);
