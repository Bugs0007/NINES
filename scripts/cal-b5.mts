import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
for (const [n, s, r, l] of [[100, false, false, true], [100, false, true, false], [800, true, true, false], [600, true, true, false], [400, true, true, false], [700, false, true, false], [1500, false, true, false], [5000, true, true, false], [1000, true, true, false]] as const) run("evalset-lab", { n, strat: s, real: r, leak: l }, ["marginPts", "uncovered", "inflationPts", "labelCost"]);
for (const [g, n] of [["exact", false], ["exact", true], ["contains", true], ["regex", true], ["schema", false], ["numeric", false]] as const) run("grader-lab", { g, norm: n }, ["falseFailPct", "falsePassPct"]);
for (const [m, r, s, w, c] of [["small", "vague", false, false, false], ["small", "detailed", true, true, true], ["large", "detailed", false, false, true], ["large", "vague", false, false, true], ["large", "detailed", true, true, true], ["small", "detailed", true, false, true]] as const) run("judge-lab", { model: m, rubric: r, shots: s, swap: w, calibrate: c }, ["agreement", "biasPts", "costPer1k", "measured"]);
for (const [n, p, t] of [[100, false, 4], [1500, true, 2.2], [1500, false, 2.4], [800, true, 2.2], [575, true, 2.2], [1200, true, 2], [2000, false, 2.4], [300, true, 2]] as const) run("regress-lab", { n, paired: p, t }, ["detectProb", "falseAlarmProb", "costPerRun", "sePts"]);
for (const [m, sh, sf, g] of [["offline", 5, false, false], ["shadow", 5, false, false], ["canary", 5, false, false], ["canary", 5, true, true], ["ab", 5, true, true], ["canary", 5, false, true], ["canary", 2, true, true], ["canary", 3, true, true], ["canary", 1, true, true]] as const) run("onoff-lab", { method: m, share: sh, shadowFirst: sf, guard: g }, ["missProb", "harmedUsers", "days"]);
const bk = ["shipBadProb", "falseBlockProb", "harmedUsers", "costPerRun", "days"];
for (const v of [{}, { n: 1500, code: true, judge: true, calibrated: true, paired: true, t: 2, canary: true, guard: true }, { n: 1500, code: true, judge: true, calibrated: false, paired: true, t: 2, canary: true, guard: true }, { n: 1500, code: true, judge: false, paired: true, t: 2, canary: true, guard: true }, { n: 1500, code: true, judge: true, calibrated: true, paired: true, t: 2, canary: false }, { n: 600, code: true, judge: true, calibrated: true, paired: true, t: 2, canary: true, guard: true }, { n: 3000, code: true, judge: true, calibrated: true, paired: true, t: 2.5, canary: true, guard: true }] as const) run("ship-lab", v as Record<string, number | boolean>, bk);
