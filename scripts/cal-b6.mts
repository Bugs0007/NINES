import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
const tc = { lockCount: true, count: 40 };
for (const [c, s, r] of [[false, false, false], [true, true, false], [true, true, true], [false, true, true], [true, false, true]] as const) run("toolcall-lab", { clear: c, strict: s, retrieve: r }, ["selectionAcc", "argValid", "toolTokens", "costPer1k"], tc);
for (const [cap, t, c] of [[50, false, false], [20, false, false], [20, true, false], [20, true, true], [15, true, true], [25, true, true], [30, true, true], [10, true, true], [18, true, true], [20, false, true]] as const) run("loop-lab", { cap, trunc: t, cache: c }, ["successRate", "costPerTask", "avgSteps", "worstCost"]);
for (const [m, v] of [["direct", false], ["cot", false], ["act", false], ["react", false], ["react", true]] as const) run("react-lab", { mode: m, verify: v }, ["accuracy", "hallucination", "tokens"]);
for (const [s, r] of [["none", 0], ["fixed", 0], ["replan", 1], ["replan", 2], ["replan", 3], ["replan", 5]] as const) run("agentplan-lab", { style: s, replans: r }, ["success", "steps", "costUsd"]);
for (const [k, w, K] of [["window", 10, 5], ["summary", 10, 5], ["retrieval", 10, 5], ["hybrid", 10, 5], ["hybrid", 10, 10], ["hybrid", 6, 8], ["hybrid", 12, 8], ["retrieval", 10, 12], ["window", 80, 5], ["hybrid", 8, 10]] as const) run("memory-lab", { kind: k, w, k: K }, ["recall", "tokensPerTurn", "costPer1kTurns"]);
for (const v of [{}, { stepCap: true }, { loopDetect: true }, { budget: 2 }, { stepCap: true, validate: true, trace: true }]) run("failure-lab", v as Record<string, boolean | number>, ["worstRunCost", "badArgsPer1k", "silentUndetected"]);
for (const [p, u] of [["none", false], ["all", false], ["writes", false], ["irreversible", false], ["irreversible", true]] as const) run("hitl-lab", { policy: p, undo: u }, ["irreversibleErrors", "reviewerHours", "reversibleDamage", "meanDelayMin"]);
const wc = { lockNovel: true, novel: 15 };
for (const d of ["workflow", "agent", "router"]) run("wfagent-lab", { design: d }, ["success", "costUsd", "latencyS"], wc);
for (const [w, p] of [[1, true], [2, true], [3, true], [4, true], [5, true], [6, true], [8, true], [4, false]] as const) run("orch-lab", { w, parallel: p }, ["quality", "latencyS", "costUsd"]);
for (const [k, q] of [[1, false], [3, false], [5, false], [5, true], [7, true], [9, true], [15, true], [6, true]] as const) run("para-lab", { k, quorum: q }, ["accuracy", "p99S", "costX"]);
for (const [p, n] of [["single", 3], ["supervisor", 2], ["supervisor", 3], ["supervisor", 4], ["debate", 3], ["swarm", 6], ["supervisor", 8]] as const) run("multiagent-lab", { pattern: p, n }, ["quality", "tokensX", "failurePct"]);
const mk = ["worstCost", "refundsIssued", "detectMin", "reviewerHours", "successRate"];
for (const v of [{}, { cap: 20, loop: true, budget: 2, gate: "irreversible", alert: true }, { cap: 20, gate: "irreversible", alert: true, idem: true }, { cap: 20, budget: 2, gate: "irreversible", alert: true }, { cap: 20, loop: true, gate: "all", alert: true }, { cap: 8, loop: true, gate: "irreversible", alert: true }, { cap: 20, gate: "none", alert: true, idem: true }]) run("meltdown-lab", v as Record<string, string | boolean | number>, mk);
