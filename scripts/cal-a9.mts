import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
for (const [e, p, r, o] of [["queue", 8, 1, false], ["queue", 8, 1, true], ["log", 8, 7, false], ["log", 24, 7, false], ["log", 24, 8, false], ["log", 24, 9, false], ["log", 20, 7, true]] as const) run("broker-lab", { engine: e, partitions: p, retention: r, ordered: o }, ["maxRate", "replayDays", "ordered", "subscribers", "storageTB"]);
for (const [o, d, t] of [["ackFirst", false, 10], ["ackAfter", false, 10], ["ackAfter", true, 5], ["ackAfter", true, 20], ["ackAfter", true, 25], ["ackAfter", true, 60], ["ackAfter", true, 180], ["ackAfter", true, 240]] as const) run("delivery-lab", { order: o, dedup: d, ttlMin: t }, ["lostPerMillion", "dupEffectsPerMillion", "extraMs", "dedupGB"]);
const dc = { lockOrdered: true, ordered: true };
for (const [r, d] of [[3, true], [5, true], [9, true], [10, true], [13, true], [14, true], [5, false]] as const) run("dlq-lab", { receives: r, dlq: d }, ["falseDlqPerDay", "blockedSec", "stuckWorkers", "wastedShare"], dc);
for (const [p, b, c] of [["unbounded", 100000, 8], ["unbounded", 100000, 12], ["drop", 1000, 8], ["block", 1000, 8], ["block", 1000, 10], ["block", 1000, 9], ["block", 1000, 11], ["block", 5000, 10], ["block", 1000, 12]] as const) run("pressure-lab", { policy: p, buffer: b, consumers: c }, ["latencyS", "droppedPct", "producerSlowPct", "memoryGB", "costPerMonth"]);
const fc = { lockN: true, n: 12 };
for (const s of ["seq", "par", "push", "queues"]) run("pubsub-lab", { style: s }, ["userMs", "userFailPct", "lostPct", "publisherChanges"], fc);
for (const [s, t] of [["sync", false], ["events", false], ["events", true]] as const) run("event-lab", { style: s, tracing: t }, ["checkoutMs", "failPct", "staleS", "traceable"]);
for (const [c, p] of [[false, false], [true, false], [true, true]] as const) run("cqrs-lab", { cqrs: c, pin: p, lagMs: 2000 }, ["readMs", "writeMs", "ownMiss", "readLoad"]);
for (const [k, w] of [[0, 1], [5000, 1], [5000, 4], [20000, 4], [50, 4], [100, 4], [9000, 4], [12000, 4], [30, 4]] as const) run("sourcing-lab", { every: k, workers: w }, ["loadMs", "storageOverhead", "writeAmp", "rebuildHours"]);
for (const [m, w, p, n] of [["naive", 8, 500, false], ["forupdate", 8, 500, false], ["skip", 40, 500, false], ["skip", 40, 500, true], ["skip", 30, 200, false], ["skip", 30, 150, false], ["skip", 40, 5, false], ["skip", 80, 500, true]] as const) run("pgqueue-lab", { method: m, workers: w, pollMs: p, notify: n }, ["jobsPerSec", "dupPct", "waitMs", "idlePolls"]);
