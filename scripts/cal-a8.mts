import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toPrecision(4) : o.metrics[k]}`).join(" ")); };
const tc = { lockClient: true, clientT: 800 };
for (const [d, p] of [[5000, false], [2000, false], [800, false], [600, false], [400, false], [200, false], [5000, true], [100, true]] as const) run("timeout-lab", { dbT: d, propagate: p }, ["success", "wastedPct", "p99Ms", "dbMsPerReq"], tc);
for (const [r, b, g] of [[0, "none", false], [3, "none", false], [6, "none", false], [3, "exp", false], [3, "jitter", false], [6, "jitter", false], [6, "none", true], [3, "none", true], [6, "jitter", true]] as const) run("retry-lab", { retries: r, backoff: b, budget: g }, ["peakX", "recoveryS", "errorRate"]);
for (const [m, t, a] of [["none", 1, false], ["attempt", 100, true], ["request", 1, true], ["request", 24, true], ["request", 48, true], ["request", 48, false], ["request", 200, true], ["request", 720, true]] as const) run("idem-lab", { mode: m, ttl: t, atomic: a }, ["dupPerDay", "storageGB"]);
for (const [th, w, o, p] of [[0.5, 5, 10, 5], [0.5, 1, 10, 5], [0.05, 1, 10, 5], [0.1, 3, 10, 5], [0.5, 5, 30, 5], [0.5, 5, 10, 20], [0.9, 10, 5, 1], [0.3, 3, 15, 3], [0.2, 2, 10, 3]] as const) run("breaker-lab", { thr: th, window: w, openS: o, probes: p }, ["callsToDead", "falseTrips", "recoveryLagS"]);
const bc = { lockDegraded: true };
for (const [l, s] of [["shared", 0.5], ["isolated", 0.5], ["isolated", 0.2], ["isolated", 0.14], ["isolated", 0.1], ["isolated", 0.3], ["isolated", 0.05]] as const) run("bulkhead-lab", { layout: l, aShare: s }, ["aBlock", "bBlock", "poolA"], bc);
for (const [th, w, o, p] of [[0.5, 5, 60, 5], [0.5, 5, 30, 1], [0.9, 30, 60, 5], [0.5, 5, 10, 1], [0.5, 5, 12, 3], [0.25, 3, 10, 3], [0.2, 2, 10, 2]] as const) run("breaker-lab", { thr: th, window: w, openS: o, probes: p }, ["callsToDead", "falseTrips", "recoveryLagS"]);
for (const d of [650, 700, 750, 900, 1000, 1200]) run("timeout-lab", { dbT: d, propagate: false }, ["success", "wastedPct", "dbMsPerReq"], tc);
for (const s of [0.15, 0.16, 0.18, 0.25, 0.28]) run("bulkhead-lab", { layout: "isolated", aShare: s }, ["aBlock", "bBlock"], bc);
