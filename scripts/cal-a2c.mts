import { viralLab } from "../src/widgets/model-lab/models/a2";
const base = viralLab.init({});
const show = (v: Record<string, number | boolean>) => { const o = viralLab.evaluate({ ...base, ...v }, {}); const m = o.metrics; console.log(JSON.stringify(v), "p99", m.p99!.toFixed(2), "err", m.errorRate!.toFixed(3), "$/mo", m.costPerMonth!.toFixed(0), "inst", m.peakInstances, "conns", m.dbConns); };
show({});
show({ warm: true, target: 0.3, minInst: 10 });
show({ warm: true, target: 0.3, minInst: 10, pooler: true });
show({ warm: true, target: 0.3, minInst: 10, pooler: true, hedgeMs: 60 });
show({ warm: true, target: 0.4, minInst: 12, pooler: true, hedgeMs: 60 });
show({ warm: true, target: 0.4, minInst: 12, pooler: true, hedgeMs: 0 });
show({ warm: true, target: 0.3, minInst: 8, pooler: true, hedgeMs: 60 });
show({ warm: true, target: 0.3, minInst: 12, pooler: true, hedgeMs: 60, perWorker: 1 });
show({ warm: true, target: 0.3, minInst: 12, pooler: false, hedgeMs: 60, perWorker: 1 });
