import { LAB_MODELS } from "../src/widgets/model-lab/models";
import { simCache, topShare } from "../src/widgets/model-lab/models/a4";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const t0 = Date.now(); const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${o.metrics[k]!.toFixed(3)}`).join(" "), `${Date.now() - t0}ms`); };
for (const e of [20, 200, 1000, 2000, 5000]) run("cache-lab", { entries: e }, ["hitRatio", "dbUtil"]);
console.log("topShare 1e6 s.99", [1e3, 1e4, 1e5, 1e6].map((c) => topShare(c, 1e6, 0.99).toFixed(3)));
console.log("topShare 1e6 s.7", [1e3, 1e4, 1e5].map((c) => topShare(c, 1e6, 0.7).toFixed(3)), "s1.2", [1e3, 1e4].map((c) => topShare(c, 1e6, 1.2).toFixed(3)));
for (const sc of [0, 0.3, 0.5]) for (const p of ["lru", "lfu", "fifo", "random"] as const) console.log("evict", sc, p, simCache(p, 400, 20000, 0.99, sc, 30000, "evict-lab").toFixed(3));
for (const [p, f] of [["through", 5], ["around", 5], ["back", 1], ["back", 5], ["back", 10], ["back", 15], ["back", 20], ["back", 30]] as const) run("write-lab", { policy: p, flush: f, writes: 5000 }, ["writeMs", "dbWriteRps", "atRiskSec"], { lockLoad: true, writes: 5000, hotKeys: 10000 });
for (const [t, inv] of [[60, false], [300, false], [3600, false], [3600, true], [300, true]] as const) run("stale-lab", { ttl: t, invalidate: inv }, ["staleShare", "hitRatio"], { readRate: 1, changeRate: 0.01 });
for (const [m, j] of [["none", false], ["none", true], ["lock", false], ["early", false], ["swr", false], ["lock", true]] as const) run("stampede-lab", { mode: m, jitter: j, keys: 40 }, ["dbPeakUtil", "errorRate", "slowestS"]);
for (const [n, r, l] of [[8, 1, 0], [8, 8, 0], [16, 1, 0], [8, 1, 20], [8, 4, 10], [32, 1, 0]] as const) run("hotkey-lab", { nodes: n, replicas: r, local: l }, ["hotNodeUtil", "imbalance"]);
for (const [n, v, t] of [[false, true, 120], [true, true, 120], [true, false, 120], [true, false, 600]] as const) run("edgecache-lab", { normalize: n, vary: v, ttl: t }, ["hitRatio", "originRps"]);
for (const v of [{}, { edge: true, ttl: 60 }, { edge: true, ttl: 60, protect: "swr", replicas: 4, writeback: true, flush: 10 }, { edge: true, ttl: 60, protect: "swr", writeback: true, flush: 10 }, { edge: true, ttl: 60, protect: "swr", replicas: 4 }, { edge: false, ttl: 60, protect: "swr", replicas: 8, writeback: true, flush: 10 }]) run("celeb-lab", v, ["p99", "errorRate", "dbPeakUtil", "hotNodeUtil", "costPerMonth"]);
for (const [e, s] of [[1e4, 0.99], [1e5, 0.99], [1e6, 0.99], [1e5, 0.7], [1e5, 1.2]] as const) run("size-lab", { entries: e, skew: s }, ["hitRatio", "memGiB", "costPerMonth"]);
console.log("---- round 2");
for (const e of [250000, 300000, 335000, 400000]) run("size-lab", { entries: e, skew: 0.99 }, ["hitRatio", "memGiB", "costPerMonth"]);
for (const [p, e] of [["lru", 400], ["lru", 500], ["lru", 600], ["lfu", 400], ["lfu", 300], ["fifo", 500]] as const) run("evict-lab", { policy: p, entries: e }, ["hitRatio", "lruHit", "lfuHit"], { lockScan: true, scan: 0.3 });
for (const [m, j] of [["none", false], ["none", true], ["lock", false], ["early", false], ["swr", false], ["lock", true]] as const) run("stampede-lab", { mode: m, jitter: j, keys: 400 }, ["dbPeakUtil", "errorRate", "slowestS"], { lockKeys: true, perKeyRps: 30, dbCap: 2000 });
for (const [n, r, l] of [[8, 1, 0], [8, 8, 0], [16, 1, 0], [8, 1, 20], [8, 4, 10], [16, 4, 0], [16, 1, 20]] as const) run("hotkey-lab", { nodes: n, replicas: r, local: l }, ["hotNodeUtil", "imbalance"]);
