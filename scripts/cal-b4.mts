import { LAB_MODELS } from "../src/widgets/model-lab/models";
const run = (id: string, v: Record<string, number | string | boolean>, keys: string[], cfg: Record<string, unknown> = {}) => { const m = LAB_MODELS[id]!; const o = m.evaluate({ ...m.init(cfg), ...((cfg.start ?? {}) as object), ...v }, cfg); console.log(id, JSON.stringify(v), keys.map((k) => `${k}=${typeof o.metrics[k] === "number" ? o.metrics[k]!.toFixed(3) : o.metrics[k]}`).join(" ")); };
for (const q of ["stuck", "parcel", "signin", "charge"]) for (const k of [3, 7]) run("embed-lab", { query: q, k }, ["precision", "recall"]);
run("embed-lab", { query: "charge", k: 7, rewrite: true }, ["precision", "recall"]);
for (const [m, n] of [["dot", false], ["cosine", false], ["euclid", false], ["dot", true]] as const) run("cosine-lab", { metric: m, normalise: n }, ["topIsRight", "matchRank"]);
for (const q of ["refund", "seven", "pigeon"]) for (const [k1, b] of [[1.2, 0.75], [3, 0], [1.2, 0], [0, 0.75], [0.5, 1]] as const) run("bm25-lab", { query: q, k1, b }, ["topIsRight", "rightRank"]);
for (const m of ["bm25", "vec", "sum", "rrf"]) run("rrf-lab", { method: m, k: 60 }, ["mrr", "inTop3", "worstRank"]);
for (const k of [1, 10, 60]) run("rrf-lab", { method: "rrf", k }, ["mrr", "inTop3", "worstRank"]);
for (const [m, q] of [["plain", 0.85], ["hyde", 0.85], ["hyde", 0.5], ["hyde", 0.2]] as const) run("hyde-lab", { method: m, quality: q }, ["precisionAt10"]);
for (const [mode, k, rr] of [["bi", 50, "cross"], ["cross-all", 50, "cross"], ["two", 20, "cross"], ["two", 100, "cross"], ["two", 300, "cross"], ["two", 500, "cross"], ["two", 1000, "cross"], ["two", 300, "llm"], ["two", 100, "llm"]] as const) run("rerank-lab", { mode, k, reranker: rr }, ["precisionAt3", "recallAtK", "latencyMs", "costUsd"]);
for (const [s, o] of [[100, 0], [256, 0], [256, 64], [400, 130], [450, 150], [500, 170], [512, 128], [1024, 0], [1500, 0]] as const) run("chunk-lab", { size: s, overlap: o, k: 5 }, ["quality", "coverage", "tokensToLlm", "indexMultiplier"], { lockK: true, k: 5 });
for (const [m, f, k] of [["post", 0.002, 100], ["post", 0.002, 5000], ["pre", 0.002, 100], ["partition", 0.002, 100], ["pre", 0.1, 100], ["post", 0.5, 100]] as const) run("filter-lab", { method: m, f, k }, ["resultsFound", "latencyMs", "complete"], { lockF: true, f });
const annc = { lockN: true, n: 50000000 };
for (const [i, q, p] of [["flat", "f32", 100], ["hnsw", "f32", 100], ["hnsw", "i8", 100], ["hnsw", "i8", 200], ["hnsw", "pq", 200], ["ivf", "pq", 200], ["ivf", "i8", 100], ["hnsw", "i8", 150]] as const) run("ann-lab", { index: i, quant: q, param: p }, ["recall", "latencyMs", "memoryGB", "fitsRam"], annc);
for (const s of ["bm25", "vec", "hybrid"]) for (const k of [1, 3, 5]) run("reteval-lab", { system: s, k }, ["recallAtK", "precisionAtK", "mrr", "ndcg"]);
